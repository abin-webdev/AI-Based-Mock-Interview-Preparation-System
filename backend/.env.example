# Django Core Settings
SECRET_KEY=django-insecure-mock-interview-secret-key-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,10.0.2.2,192.168.*,*.onrender.com

# Database (Leave blank to use default local SQLite db.sqlite3)
# In production (Render PostgreSQL): postgresql://user:password@host:port/dbname
DATABASE_URL=

# CORS Settings (comma-separated origins)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8080,http://127.0.0.1:8080

# AI Provider Configuration (Google Gemini)
GEMINI_API_KEY=your_gemini_api_key_here

# Camera Analysis Module Configuration
ENABLE_CAMERA_ANALYSIS=True
MAX_UPLOAD_SIZE_MB=25

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
